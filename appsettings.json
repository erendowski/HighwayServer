{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "HighwayServer.Mqtt": "Debug"
      }
    }
  },
  "Mqtt": {
    "Host": "emqx",
    "Port": 1883,
    "ClientId": "HighwayServer",
    "Username": null,
    "Password": null,
    "ReconnectDelaySeconds": 5
  },
  "InfluxDb": {
    "Url": "http://influxdb:8086",
    "Token": "highway-token",
    "Org": "highway",
    "Bucket": "highway"
  },
  "Cors": {
    "Origins": []
  }
}
