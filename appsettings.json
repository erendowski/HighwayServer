{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "emqx",
    "Port": 1883,
    "ClientId": "HighwayServer"
  },
  "InfluxDb": {
    "Url": "http://influxdb:8086",
    "Token": "highway-token",
    "Org": "highway",
    "Bucket": "highway"
  },
  "Cors": {
    "Origins": [
      "http://localhost",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  }
}
