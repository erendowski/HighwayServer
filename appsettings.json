{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "HighwayServer.Mqtt": "Debug"
      }
    }
  },
  "Mqtt": {
    "Host": "emqx",
    "Port": 1883,
    "ClientId": "HighwayServer",
    "Username": null,
    "Password": null,
    "ReconnectDelaySeconds": 5
  },
  "InfluxDb": {
    "Url": "http://influxdb:8086",
    "Token": "highway-token",
    "Org": "highway",
    "Bucket": "highway"
  },
  "Cors": {
    "Origins": []
  },
  "AnomalyThresholds": {
    "StoppedSpeedKmh": 5.0,
    "StoppedDurationSec": 4,
    "SlowSpeedKmh": 40.0,
    "FastSpeedKmh": 130.0,
    "ExtremeFastSpeedKmh": 160.0,
    "SuddenBrakeDeltaKmhPerSec": -25.0,
    "SuddenAccelDeltaKmhPerSec": 20.0,
    "DebounceSec": 10
  }
}
